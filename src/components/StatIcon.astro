---
// Iconos de las tarjetas del hero. Trazados a mano con `currentColor`
// para que se recoloreen solos con cada paleta: un SVG plano descargado
// quedaria fijo en un color y chocaria con las 4 paletas.
type Props = { name: 'person' | 'location' | 'craft'; class?: string };
const { name, class: className = '' } = Astro.props;

const paths = {
  person: '<circle cx="12" cy="8" r="4" /><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />',
  location:
    '<path d="M12 21.5c4-4.4 6.5-7.6 6.5-11a6.5 6.5 0 1 0-13 0c0 3.4 2.5 6.6 6.5 11Z" /><circle cx="12" cy="10.5" r="2.5" />',
  craft:
    '<path d="M14.6 6.4a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.2-3.2a6 6 0 0 1-7.9 7.9l-6.4 6.4a2.1 2.1 0 0 1-3-3l6.4-6.4a6 6 0 0 1 7.9-7.9l-3.2 3.2Z" />',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>

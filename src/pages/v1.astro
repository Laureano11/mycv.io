---
// v1 — Editorial. Implementacion de referencia para las variantes v2..v5.
// Patron a copiar: importar datos de cv.ts, envolver en VariantLayout,
// usar SOLO los tokens fg / fg-soft / page / panel / hairline / brand.
import VariantLayout from '../layouts/VariantLayout.astro';
import {
  profile,
  heroStats,
  facts,
  projects,
  architectureGroups,
  technologyGroups,
  languages,
  finance,
} from '../data/cv.ts';

const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap';

const [bioMain, bioClosing] = profile.bio.split('\n');
---

<VariantLayout
  title={`${profile.name} — Portfolio`}
  description={profile.role}
  palette="papel"
  fonts={fonts}
  current={1}
>
  <div class="editorial">
    <a href="#projects" class="skip">Skip to projects</a>

    <div class="mx-auto max-w-4xl px-6 sm:px-8">
      <header class="flex items-baseline justify-between gap-6 py-7">
        <a href="#top" class="display text-lg text-fg">{profile.name}</a>
        <nav class="flex gap-6 text-[0.95rem] text-fg-soft">
          <a class="hover:text-fg" href="#projects">Projects</a>
          <a class="hover:text-fg" href="#stack">Stack</a>
          <a class="hover:text-fg" href="#markets">Markets</a>
          <a class="hover:text-fg" href="#contact">Contact</a>
        </nav>
      </header>

      <main id="top">
        <!-- Hero: el nombre es el elemento memorable. Sin tarjetas, sin gradientes. -->
        <section class="border-t border-hairline pt-12 sm:pt-16">
          <h1 class="display text-[clamp(2.75rem,8vw,5rem)] font-normal leading-[0.95] text-fg">
            {profile.name}
          </h1>
          <p class="mt-5 text-xl text-fg-soft sm:text-2xl">{profile.role}</p>

          <div class="mt-10 max-w-[66ch] space-y-5 text-[1.0625rem] leading-[1.75] text-fg">
            <p>{bioMain}</p>
            {bioClosing && <p class="text-fg-soft">{bioClosing}</p>}
          </div>

          <div class="mt-12 grid gap-6 border-y border-hairline py-7 sm:grid-cols-3">
            {
              heroStats.map((stat) => (
                <div>
                  <p class="display text-2xl text-fg">{stat.value}</p>
                  <p class="mt-1.5 text-[0.95rem] leading-6 text-fg-soft">{stat.label}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Datos personales: definition list real, no un formulario apretado. -->
        <section class="pt-14">
          <h2 class="display text-3xl text-fg">Profile</h2>
          <dl class="mt-7 grid gap-x-10 gap-y-5 sm:grid-cols-2">
            {
              facts.map((fact) => (
                <div class="flex flex-col gap-1 border-b border-hairline pb-4">
                  <dt class="text-[0.9rem] text-fg-soft">{fact.label}</dt>
                  <dd class="text-[1.0625rem] leading-7 text-fg">
                    {fact.href ? (
                      <a class="link" href={fact.href}>{fact.value}</a>
                    ) : (
                      fact.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <!-- Proyectos: fila de nota de research. Categoria a la izquierda, contenido a la derecha.
             El `status` es una categoria real del contenido, por eso encabeza la fila. -->
        <section id="projects" class="pt-16">
          <h2 class="display text-3xl text-fg">Projects</h2>
          <p class="mt-5 max-w-[66ch] text-[1.0625rem] leading-[1.75] text-fg-soft">
            {profile.projectsNote}
          </p>

          <div class="mt-10">
            {
              projects.map((project) => (
                <article class="grid gap-4 border-t border-hairline py-9 sm:grid-cols-[10rem_1fr] sm:gap-10">
                  <p class="text-[0.95rem] leading-6 text-fg-soft">{project.status}</p>

                  <div>
                    <h3 class="display text-2xl leading-tight text-fg">{project.name}</h3>
                    <p class="mt-3 max-w-[64ch] text-[1.0625rem] leading-[1.7] text-fg">
                      {project.summary}
                    </p>
                    <p class="mt-3 max-w-[64ch] text-[1.0625rem] leading-[1.7] text-fg-soft">
                      {project.highlight}
                    </p>

                    <ul class="mt-5 flex flex-wrap gap-2">
                      {project.stack.map((item) => (
                        <li class="rounded-full border border-hairline bg-panel px-3 py-1 text-sm text-fg-soft">
                          {item}
                        </li>
                      ))}
                    </ul>

                    {project.specialTags && (
                      <ul class="mt-2.5 flex flex-wrap gap-2">
                        {project.specialTags.map((tag) => (
                          <li class="rounded-full border border-brand/30 bg-brand/10 px-3 py-1 text-sm font-medium text-brand">
                            {tag}
                          </li>
                        ))}
                      </ul>
                    )}

                    <p class="mt-6">
                      <a class="link" href={project.repoUrl} target="_blank" rel="noreferrer">
                        View repository
                      </a>
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </section>

        <section id="stack" class="border-t border-hairline pt-16">
          <h2 class="display max-w-[24ch] text-3xl leading-tight text-fg">
            {profile.architectureHeading}
          </h2>

          <div class="mt-9 grid gap-x-10 gap-y-9 sm:grid-cols-2">
            {
              architectureGroups.map((group) => (
                <div>
                  <h3 class="display text-xl text-fg">{group.title}</h3>
                  <ul class="mt-4 space-y-2.5 text-[1.0625rem] leading-7 text-fg-soft">
                    {group.items.map((item) => (
                      <li class="border-b border-hairline pb-2.5">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>

          <div class="mt-12 space-y-9">
            {
              technologyGroups.map((group) => (
                <div>
                  <h3 class="display text-xl text-fg">{group.title}</h3>
                  <ul class="mt-3.5 flex flex-wrap gap-2">
                    {group.items.map((item) => (
                      <li class="rounded-full border border-hairline bg-panel px-3 py-1 text-sm text-fg-soft">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }

            <div>
              <h3 class="display text-xl text-fg">Languages</h3>
              <ul class="mt-3.5 flex flex-wrap gap-2">
                {
                  languages.map((item) => (
                    <li class="rounded-full border border-hairline bg-panel px-3 py-1 text-sm text-fg-soft">
                      {item}
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </section>

        <!-- Mercados: el lado que distingue este CV de uno de software puro. -->
        <section id="markets" class="border-t border-hairline pt-16">
          <h2 class="display text-3xl text-fg">Finance and markets</h2>
          <dl class="mt-8 grid gap-x-10 sm:grid-cols-[11rem_1fr]">
            {
              finance.map((item) => (
                <div class="contents">
                  <dt class="border-t border-hairline pt-4 text-[0.95rem] leading-7 text-fg-soft sm:pb-4">
                    {item.label}
                  </dt>
                  <dd class="border-hairline pb-4 text-[1.0625rem] leading-7 text-fg sm:border-t sm:pt-4">
                    {item.detail}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section id="contact" class="border-t border-hairline pt-16">
          <h2 class="display max-w-[22ch] text-3xl leading-tight text-fg">
            {profile.contactHeading}
          </h2>
          <p class="mt-5 max-w-[62ch] text-[1.0625rem] leading-[1.75] text-fg-soft">
            {profile.contactNote}
          </p>
          <p class="mt-7 flex flex-col gap-3 text-[1.0625rem] sm:flex-row sm:gap-8">
            <a class="link" href={profile.emailHref}>{profile.email}</a>
            <a class="link" href={profile.phoneHref}>{profile.phone}</a>
          </p>
        </section>
      </main>

      <footer
        class="mt-16 flex flex-col gap-1.5 border-t border-hairline py-9 text-[0.95rem] text-fg-soft sm:flex-row sm:justify-between"
      >
        <p>{profile.footerLeft}</p>
        <p>{profile.footerRight}</p>
      </footer>
    </div>
  </div>
</VariantLayout>

<style>
  /* Tipografia local a la variante: no toca la config global de Tailwind. */
  .editorial {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-feature-settings: 'cv05' 1;
  }

  .editorial .display,
  .editorial h1,
  .editorial h2,
  .editorial h3 {
    font-family: 'Fraunces', Iowan Old Style, Georgia, serif;
    font-optical-sizing: auto;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .editorial h1 {
    font-weight: 400;
  }

  .link {
    color: rgb(var(--brand));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .link:hover {
    text-decoration-thickness: 2px;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 60;
    background: rgb(var(--panel));
    color: rgb(var(--fg));
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
</style>

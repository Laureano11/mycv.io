---
// v2 — Tarjetas suaves. Misma base que v1 (datos de cv.ts + VariantLayout),
// otra forma: la tarjeta se reserva para el proyecto, que es la unidad real.
// El resto de las secciones se apoya en hairlines y espacio, no en mas tarjetas.
import VariantLayout from '../layouts/VariantLayout.astro';
import StatIcon from '../components/StatIcon.astro';
import {
  profile,
  heroStats,
  facts,
  projects,
  architectureGroups,
  techGroups,
  finance,
} from '../data/cv.ts';

const fonts =
  'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap';

const [bioMain, bioClosing] = profile.bio.split('\n');
---

<VariantLayout
  title={`${profile.name} — Portfolio`}
  description={profile.role}
  palette="niebla"
  fonts={fonts}
  current={2}
>
  <div class="soft">
    <a href="#projects" class="skip">Skip to projects</a>

    <header class="sticky top-0 z-40 border-b border-hairline bg-page/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:gap-6 sm:px-8">
        <a href="#top" class="text-base font-semibold text-fg">{profile.name}</a>
        <nav class="flex shrink-0 items-center gap-4 text-base text-fg-soft sm:gap-7">
          <a class="nav" href="#projects">Projects</a>
          <a class="nav hidden sm:inline" href="#stack">Stack</a>
          <a class="nav hidden sm:inline" href="#markets">Markets</a>
          <a class="nav" href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top" class="mx-auto max-w-6xl px-5 pb-4 sm:px-8">
      <!-- Hero abierto: sin tarjeta. La primera tarjeta de la pagina es un proyecto. -->
      <section class="pt-14 sm:pt-20">
        <h1 class="max-w-[16ch] text-[clamp(2.5rem,7vw,4.25rem)] font-bold leading-[1.05] tracking-[-0.03em] text-fg">
          {profile.name}
        </h1>
        <p class="mt-4 text-xl font-medium text-fg-soft sm:text-2xl">{profile.role}</p>

        <div class="mt-8 max-w-[68ch] space-y-5 text-[1.0625rem] leading-[1.75] text-fg">
          <p>{bioMain}</p>
          {bioClosing && <p class="text-fg-soft">{bioClosing}</p>}
        </div>

        <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl bg-hairline sm:grid-cols-3">
          {
            heroStats.map((stat) => (
              <li class="flex items-center gap-3 bg-page px-5 py-5">
                <StatIcon name={stat.icon} class="h-5 w-5 shrink-0 text-brand" />
                <span class="text-base leading-6 text-fg">{stat.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Datos personales: rejilla con hairlines, no nueve tarjetitas. -->
      <section class="pt-16 sm:pt-20">
        <h2 class="text-3xl font-bold tracking-[-0.02em] text-fg">Profile</h2>
        <dl class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
          {
            facts.map((fact) => (
              <div class="border-t border-hairline py-4">
                <dt class="text-sm font-medium text-fg-soft">{fact.label}</dt>
                <dd class="mt-1 break-words text-[1.0625rem] leading-7 text-fg">
                  {fact.href ? (
                    <a class="link" href={fact.href}>
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                  {fact.note && (
                    <span class="mt-1 block text-base leading-6 text-fg-soft">{fact.note}</span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Proyectos: aca si, tarjetas. Cada una es una unidad completa y legible sin clics. -->
      <section id="projects" class="pt-16 sm:pt-20">
        <h2 class="text-3xl font-bold tracking-[-0.02em] text-fg">Projects</h2>
        <p class="mt-4 max-w-[68ch] text-[1.0625rem] leading-[1.75] text-fg-soft">
          {profile.projectsNote}
        </p>

        <div class="mt-9 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            projects.map((project) => (
              <article class="card flex flex-col rounded-3xl border border-hairline bg-panel p-6">
                <p class="flex items-center gap-2 text-sm font-medium text-fg-soft">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-brand" aria-hidden="true" />
                  {project.status}
                </p>

                <h3 class="mt-3 text-xl font-semibold leading-snug tracking-[-0.01em] text-fg">
                  {project.name}
                </h3>

                <p class="mt-3 text-base leading-7 text-fg">{project.summary}</p>
                <p class="mt-2.5 text-base leading-7 text-fg-soft">{project.highlight}</p>

                <ul class="mt-5 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <li class="rounded-full border border-hairline bg-page px-3 py-1 text-sm text-fg-soft">
                      {item}
                    </li>
                  ))}
                </ul>

                {project.specialTags && (
                  <ul class="mt-2.5 flex flex-wrap gap-2">
                    {project.specialTags.map((tag) => (
                      <li class="rounded-full border border-brand/30 bg-brand/10 px-3 py-1 text-sm font-medium text-brand">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}

                <p class="mt-6 pt-5 border-t border-hairline">
                  <a class="link" href={project.repoUrl} target="_blank" rel="noreferrer">
                    View repository
                  </a>
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Arquitectura y stack: listas y chips sobre la pagina, sin envolverlas en tarjetas. -->
      <section id="stack" class="pt-16 sm:pt-20">
        <h2 class="max-w-[26ch] text-3xl font-bold leading-tight tracking-[-0.02em] text-fg">
          {profile.architectureHeading}
        </h2>

        <div class="mt-8 grid gap-x-12 gap-y-10 sm:grid-cols-2">
          {
            architectureGroups.map((group) => (
              <div>
                <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
                <ul class="mt-4 space-y-3">
                  {group.items.map((item) => (
                    <li class="flex gap-3 text-[1.0625rem] leading-7 text-fg-soft">
                      <span
                        class="mt-3 h-1 w-1 shrink-0 rounded-full bg-brand"
                        aria-hidden="true"
                      />
                      <span class="max-w-[52ch]">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="mt-12 space-y-8">
          {
            techGroups.map((group) => (
              <div>
                <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {group.items.map((tech) => (
                    <li
                      class:list={[
                        'flex items-center gap-2 rounded-full border border-hairline bg-panel py-1 text-sm text-fg',
                        tech.logo ? 'pl-1.5 pr-3.5' : 'px-3.5',
                      ]}
                    >
                      {tech.logo && (
                        <img
                          src={`/logos/${tech.logo}`}
                          alt=""
                          width="20"
                          height="20"
                          loading="lazy"
                          class="h-5 w-5 shrink-0 object-contain"
                        />
                      )}
                      {tech.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section id="markets" class="pt-16 sm:pt-20">
        <h2 class="text-3xl font-bold tracking-[-0.02em] text-fg">Finance and markets</h2>
        <dl class="mt-8 grid gap-x-12 sm:grid-cols-2">
          {
            finance.map((item) => (
              <div class="border-t border-hairline py-5">
                <dt class="text-sm font-medium text-fg-soft">{item.label}</dt>
                <dd class="mt-1.5 max-w-[56ch] text-[1.0625rem] leading-7 text-fg">
                  {item.detail}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Cierre: panel con tinte de acento, deliberadamente distinto de las tarjetas de proyecto. -->
      <section
        id="contact"
        class="mt-16 rounded-3xl border border-brand/20 bg-brand/[0.06] p-6 sm:mt-20 sm:p-10"
      >
        <h2 class="max-w-[22ch] text-3xl font-bold leading-tight tracking-[-0.02em] text-fg">
          {profile.contactHeading}
        </h2>
        <p class="mt-4 max-w-[62ch] text-[1.0625rem] leading-[1.75] text-fg-soft">
          {profile.contactNote}
        </p>
        <div class="mt-7">
          <a
            class="cta inline-flex items-center justify-center bg-brand font-medium text-on-brand rounded-full px-6 py-3 text-[1.0625rem]"
            href={profile.emailHref}
          >
            {profile.contactCta}
          </a>
        </div>
      </section>

      <footer
        class="mt-12 flex flex-col gap-6 border-t border-hairline py-8 text-sm text-fg-soft sm:flex-row sm:justify-between"
      >
        <div class="flex flex-col gap-1.5">
          <p>{profile.footerLeft}</p>
          <p>{profile.footerRight}</p>
        </div>
        <div class="flex flex-col gap-1.5 sm:items-end">
          <a class="link" href={profile.emailHref}>{profile.email}</a>
          <a class="link" href={profile.phoneHref}>{profile.phone}</a>
          <a class="link" href={profile.linkedin} target="_blank" rel="noreferrer">{profile.linkedinLabel}</a>
        </div>
      </footer>
    </main>
  </div>
</VariantLayout>

<style>
  /* Tipografia local a la variante: no toca la config global de Tailwind. */
  .soft {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  /* Sombra suave, en el color del texto de la paleta activa para no ensuciar el tono. */
  .card {
    box-shadow:
      0 1px 2px rgb(var(--fg) / 0.04),
      0 10px 28px -16px rgb(var(--fg) / 0.16);
    transition:
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .card:hover {
    box-shadow:
      0 1px 2px rgb(var(--fg) / 0.05),
      0 16px 36px -18px rgb(var(--fg) / 0.22);
    transform: translateY(-2px);
  }

  .link {
    color: rgb(var(--brand));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .link:hover {
    text-decoration-thickness: 2px;
  }

  .nav {
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .nav:hover {
    color: rgb(var(--fg));
    border-bottom-color: rgb(var(--brand));
  }

  .cta {
    transition: opacity 150ms ease;
  }

  .cta:hover {
    opacity: 0.88;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 60;
    background: rgb(var(--panel));
    color: rgb(var(--fg));
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>

---
// v3 — Dos columnas. Barra lateral sticky con la identidad y los datos duros;
// el contenido largo scrollea a la derecha. Sigue el patron de v1:
// datos de cv.ts, VariantLayout, y SOLO los tokens fg / fg-soft / page / panel /
// hairline / brand. El CSS propio vive en el <style> de abajo.
import VariantLayout from '../layouts/VariantLayout.astro';
import StatIcon from '../components/StatIcon.astro';
import {
  profile,
  heroStats,
  facts,
  projects,
  techGroups,
  finance,
} from '../data/cv.ts';

const fonts =
  'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap';

const [bioMain, bioClosing] = profile.bio.split('\n');

const nav = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#stack', label: 'Technologies' },
  { href: '#markets', label: 'Markets' },
  { href: '#contact', label: 'Contact' },
];
---

<VariantLayout
  title={`${profile.name} — Portfolio`}
  description={profile.role}
  palette="lino"
  fonts={fonts}
  current={3}
>
  <div class="two-col mx-auto flex max-w-[1200px] flex-col lg:flex-row lg:items-start">
    <a href="#about" class="skip">Skip to content</a>

    <!-- Barra lateral: identidad + datos duros. Sticky solo en desktop y con
         scroll propio, para que nunca se corte si no entra en la ventana. -->
    <header
      class="sidebar w-full border-b border-hairline bg-panel px-6 py-8 sm:px-8 lg:sticky lg:top-0 lg:h-screen lg:w-[320px] lg:shrink-0 lg:overflow-y-auto lg:border-b-0 lg:border-r lg:py-10"
    >
      <a href="#about" class="block text-2xl font-semibold leading-tight text-fg">
        {profile.name}
      </a>
      <p class="mt-2 text-base leading-6 text-fg-soft">{profile.role}</p>

      <nav aria-label="Sections" class="mt-6 border-y border-hairline py-4">
        <ul class="flex flex-wrap gap-x-5 gap-y-2 lg:flex-col lg:gap-y-2.5">
          {
            nav.map((item) => (
              <li>
                <a class="nav-link text-base text-fg-soft" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-1 lg:gap-3.5">
        {
          facts.map((fact) => (
            <div>
              <dt class="text-sm leading-5 text-fg-soft">{fact.label}</dt>
              <dd class="mt-0.5 break-words text-base leading-6 text-fg">
                {fact.href ? (
                  <a class="link" href={fact.href}>
                    {fact.value}
                  </a>
                ) : (
                  fact.value
                )}
                {fact.note && (
                  <span class="mt-1 block text-base leading-6 text-fg-soft">{fact.note}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        class="cta mt-7 inline-flex items-center justify-center rounded-lg bg-brand px-4 py-2.5 text-base font-medium text-on-brand"
        href={profile.emailHref}
      >
        {profile.contactCta}
      </a>
    </header>

    <!-- Columna de contenido. min-w-0 evita que los chips o el texto largo
         empujen el layout y generen scroll horizontal en movil. -->
    <main class="min-w-0 flex-1 px-6 py-10 sm:px-8 lg:px-12 lg:py-14">
      <section id="about" class="scroll-mt-6">
        <h2 class="text-2xl font-semibold text-fg">About</h2>
        <div class="mt-5 max-w-[68ch] space-y-4 text-base leading-[1.7] text-fg">
          <p>{bioMain}</p>
          {bioClosing && <p class="text-fg-soft">{bioClosing}</p>}
        </div>

        <ul class="mt-8 grid gap-5 border-y border-hairline py-6 sm:grid-cols-3">
          {
            heroStats.map((stat) => (
              <li class="flex items-center gap-3">
                <StatIcon name={stat.icon} class="h-5 w-5 shrink-0 text-brand" />
                <span class="text-base leading-6 text-fg">{stat.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="projects" class="mt-12 scroll-mt-6">
        <h2 class="text-2xl font-semibold text-fg">Projects</h2>
        <p class="mt-4 max-w-[68ch] text-base leading-[1.7] text-fg-soft">
          {profile.projectsNote}
        </p>

        <div class="mt-8 space-y-0">
          {
            projects.map((project) => (
              <article class="border-t border-hairline py-7">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="text-xl font-semibold leading-tight text-fg">{project.name}</h3>
                  <p class="text-sm leading-5 text-fg-soft">{project.status}</p>
                </div>

                <p class="mt-3 max-w-[68ch] text-base leading-[1.7] text-fg">{project.summary}</p>
                <p class="mt-2 max-w-[68ch] text-base leading-[1.7] text-fg-soft">
                  {project.highlight}
                </p>

                <ul class="mt-4 flex flex-wrap gap-2">
                  {project.stack.map((item) => (
                    <li class="rounded-full border border-hairline bg-panel px-3 py-1 text-sm text-fg-soft">
                      {item}
                    </li>
                  ))}
                </ul>

                {project.specialTags && (
                  <ul class="mt-2 flex flex-wrap gap-2">
                    {project.specialTags.map((tag) => (
                      <li class="rounded-full border border-brand/30 bg-brand/10 px-3 py-1 text-sm font-medium text-brand">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}

                <p class="mt-5 text-base">
                  <a class="link" href={project.repoUrl} target="_blank" rel="noreferrer">
                    View repository
                  </a>
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="stack" class="mt-12 scroll-mt-6 border-t border-hairline pt-10">
        <h2 class="text-2xl font-semibold text-fg">Technologies</h2>
        <div class="mt-7 space-y-7">
          {
            techGroups.map((group) => (
              <div>
                <h3 class="text-lg font-semibold text-fg">{group.title}</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {group.items.map((tech) => (
                    <li
                      class:list={[
                        'flex items-center gap-2 rounded-full border border-hairline bg-panel py-1 text-sm text-fg',
                        tech.logo ? 'pl-1.5 pr-3.5' : 'px-3.5',
                      ]}
                    >
                      {tech.logo && (
                        <img
                          src={`/logos/${tech.logo}`}
                          alt=""
                          width="20"
                          height="20"
                          loading="lazy"
                          class="h-5 w-5 shrink-0 object-contain"
                        />
                      )}
                      {tech.name}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <section id="markets" class="mt-12 scroll-mt-6 border-t border-hairline pt-10">
        <h2 class="text-2xl font-semibold text-fg">Finance and markets</h2>
        <dl class="mt-6 grid gap-x-8 sm:grid-cols-[10.5rem_1fr]">
          {
            finance.map((item) => (
              <div class="contents">
                <dt class="border-t border-hairline pt-3 text-base leading-7 text-fg-soft sm:pb-3">
                  {item.label}
                </dt>
                <dd class="border-hairline pb-3 text-base leading-7 text-fg sm:border-t sm:pt-3">
                  {item.detail}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="contact" class="mt-12 scroll-mt-6 border-t border-hairline pt-10">
        <h2 class="max-w-[26ch] text-2xl font-semibold leading-snug text-fg">
          {profile.contactHeading}
        </h2>
        <p class="mt-4 max-w-[68ch] text-base leading-[1.7] text-fg-soft">{profile.contactNote}</p>
        <p class="mt-5 flex flex-col gap-2.5 text-base sm:flex-row sm:gap-8">
          <a class="cta inline-flex items-center justify-center bg-brand font-medium text-on-brand rounded-lg px-5 py-3 text-base" href={profile.emailHref}>
            {profile.contactCta}
          </a>
        </p>
      </section>

      <footer
        class="mt-12 flex flex-col gap-6 border-t border-hairline pt-7 text-sm text-fg-soft sm:flex-row sm:justify-between"
      >
        <div class="flex flex-col gap-1.5">
          <p>{profile.footerLeft}</p>
          <p>{profile.footerRight}</p>
        </div>
        <div class="flex flex-col gap-1.5 sm:items-end">
          <a class="link" href={profile.emailHref}>{profile.email}</a>
          <a class="link" href={profile.phoneHref}>{profile.phone}</a>
          <a class="link" href={profile.linkedin} target="_blank" rel="noreferrer">{profile.linkedinLabel}</a>
        </div>
      </footer>
    </main>
  </div>
</VariantLayout>

<style>
  /* Tipografia local a la variante: no toca la config global de Tailwind. */
  .two-col {
    font-family: 'IBM Plex Sans', system-ui, -apple-system, Segoe UI, sans-serif;
  }

  /* La barra lateral scrollea dentro de si misma cuando es sticky, asi que
     necesita aire abajo para que el ultimo dato no quede pegado al borde. */
  @media (min-width: 1024px) {
    .sidebar {
      padding-bottom: 3rem;
      scrollbar-width: thin;
    }
  }

  .link {
    color: rgb(var(--brand));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .link:hover {
    text-decoration-thickness: 2px;
  }

  .nav-link {
    text-decoration: none;
  }

  .nav-link:hover {
    color: rgb(var(--fg));
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .cta:hover {
    background: rgb(var(--brand) / 0.88);
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 1rem;
    top: 1rem;
    z-index: 60;
    background: rgb(var(--panel));
    color: rgb(var(--fg));
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }

  /* Impresion: la barra deja de ser sticky y se apila arriba, como en movil. */
  @media print {
    .sidebar {
      position: static;
      height: auto;
      overflow: visible;
      width: 100%;
      border-right: 0;
      border-bottom: 1px solid rgb(var(--hairline));
      break-inside: avoid;
    }

    .two-col {
      display: block;
    }

    article,
    section {
      break-inside: avoid;
    }
  }
</style>
